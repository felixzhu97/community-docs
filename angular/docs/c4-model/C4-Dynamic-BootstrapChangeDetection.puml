@startuml Angular_Bootstrap_Change_Detection
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Dynamic.puml

title Dynamic diagram for Angular — bootstrap and change detection

Person(dev, "Developer / runtime")
Container(platformBrowser, "platform-browser", "Bootstraps platform + root component")
Container(core, "core", "ApplicationRef, DI, CD, rendering")
System_Ext(dom, "Browser DOM", "Nodes and events")

Rel(dev, platformBrowser, "bootstrapApplication / platformBrowserDynamic")
Rel(platformBrowser, core, "Create platform & root injector")
Rel(core, core, "Create root component ref / ApplicationRef")
Rel(core, dom, "Initial render into host element")
Rel(dom, core, "User events / async completions")
Rel(core, core, "Schedule change detection")
Rel(core, dom, "Apply view updates")

SHOW_LEGEND()
@enduml
