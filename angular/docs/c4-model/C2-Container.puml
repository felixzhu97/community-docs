@startuml Angular_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title 容器图 — Angular

Person(dev, "应用开发者", "消费已发布的包。")
System_Ext(app, "应用工作区", "依赖 @angular/* 的应用（本 monorepo 之外）。")

System_Boundary(mono, "angular/angular monorepo") {

    Container(core, "core", "TypeScript / @angular/core", "DI、change detection、signals、组件/指令运行时、ApplicationRef。")
    Container(compiler, "compiler", "TypeScript / @angular/compiler", "模板与装饰器编译模型（Ivy）。")
    Container(compilerCli, "compiler-cli", "TypeScript / @angular/compiler-cli", "ngtsc 转换与 Angular 编译器 CLI 集成。")
    Container(common, "common", "TypeScript / @angular/common", "常用指令、管道、HTTP 工具。")
    Container(router, "router", "TypeScript / @angular/router", "路由与导航。")
    Container(forms, "forms", "TypeScript / @angular/forms", "模板驱动与响应式表单。")
    Container(platformBrowser, "platform-browser", "TypeScript / @angular/platform-browser", "DOM 渲染器、浏览器启动。")
    Container(platformServer, "platform-server", "TypeScript / @angular/platform-server", "服务端渲染适配。")
    Container(others, "其他包", "TypeScript", "animations、elements、localize、service-worker、ssr、upgrade、zone.js、language-service 等。")
    Container(adevApp, "adev", "Angular 应用", "adev/ 下的文档站源码。")
    Container(tooling, "Monorepo 工具链", "Bazel / pnpm", "构建图、测试、打包（BUILD.bazel、pnpm workspace）。")
}

System_Ext(npm, "npm 仓库", "@angular/* 制品。")
System_Ext(browser, "浏览器", "DOM 运行时。")
System_Ext(node, "Node.js", "SSR 运行时。")

Rel(dev, app, "构建产品应用")
Rel(app, core, "使用运行时 API")
Rel(app, common, "使用 common API")
Rel(app, router, "使用路由")
Rel(app, forms, "使用表单")
Rel(app, platformBrowser, "在浏览器中启动")
Rel(app, platformServer, "可选 SSR")
Rel(app, others, "可选功能")

Rel(compilerCli, compiler, "调用编译流水线")
Rel(compilerCli, core, "产出运行时消费的定义")
Rel(platformBrowser, core, "平台与渲染器绑定")
Rel(platformServer, core, "服务端平台绑定")
Rel(common, core, "基于 core 原语")
Rel(router, core, "基于 core 原语")
Rel(forms, core, "基于 core 原语")
Rel(others, core, "基于 core 原语")

Rel(tooling, core, "构建包")
Rel(tooling, compiler, "构建包")
Rel(tooling, compilerCli, "构建包")
Rel(adevApp, core, "使用框架")
Rel(adevApp, router, "使用框架")

Rel(core, npm, "已发布")
Rel(compiler, npm, "已发布")
Rel(compilerCli, npm, "已发布")
Rel(common, npm, "已发布")
Rel(router, npm, "已发布")
Rel(forms, npm, "已发布")
Rel(platformBrowser, npm, "已发布")
Rel(platformServer, npm, "已发布")
Rel(others, npm, "已发布")

Rel(platformBrowser, browser, "DOM / 事件")
Rel(platformServer, node, "SSR 渲染")

SHOW_LEGEND()
@enduml
