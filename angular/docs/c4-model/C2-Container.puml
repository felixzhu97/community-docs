@startuml Angular_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title Container diagram for Angular

Person(dev, "Application developer", "Consumes published packages")
System_Ext(app, "Application workspace", "App that depends on @angular/* (outside this monorepo)")

System_Boundary(mono, "angular/angular monorepo") {

    Container(core, "core", "TypeScript / @angular/core", "DI, change detection, signals, components/directives runtime, ApplicationRef")
    Container(compiler, "compiler", "TypeScript / @angular/compiler", "Template & decorator compilation model (Ivy)")
    Container(compilerCli, "compiler-cli", "TypeScript / @angular/compiler-cli", "ngtsc transforms and Angular compiler CLI integration")
    Container(common, "common", "TypeScript / @angular/common", "Common directives, pipes, HTTP utilities")
    Container(router, "router", "TypeScript / @angular/router", "Routing and navigation")
    Container(forms, "forms", "TypeScript / @angular/forms", "Template-driven and reactive forms")
    Container(platformBrowser, "platform-browser", "TypeScript / @angular/platform-browser", "DOM renderer, browser bootstrap")
    Container(platformServer, "platform-server", "TypeScript / @angular/platform-server", "Server-side rendering adapters")
    Container(others, "Other packages", "TypeScript", "animations, elements, localize, service-worker, ssr, upgrade, zone.js, language-service, …")
    Container(adevApp, "adev", "Angular app", "Documentation site sources under adev/")
    Container(tooling, "Monorepo tooling", "Bazel / pnpm", "Build graph, tests, packaging (BUILD.bazel, pnpm workspace)")
}

System_Ext(npm, "npm registry", "@angular/* artifacts")
System_Ext(browser, "Browser", "DOM runtime")
System_Ext(node, "Node.js", "SSR runtime")

Rel(dev, app, "Builds product app")
Rel(app, core, "Uses runtime APIs")
Rel(app, common, "Uses common APIs")
Rel(app, router, "Uses routing")
Rel(app, forms, "Uses forms")
Rel(app, platformBrowser, "Bootstraps in browser")
Rel(app, platformServer, "Optional SSR")
Rel(app, others, "Optional features")

Rel(compilerCli, compiler, "Invokes compilation pipeline")
Rel(compilerCli, core, "Emits definitions consumed at runtime")
Rel(platformBrowser, core, "Platform + renderer bindings")
Rel(platformServer, core, "Server platform bindings")
Rel(common, core, "Built on core primitives")
Rel(router, core, "Built on core primitives")
Rel(forms, core, "Built on core primitives")
Rel(others, core, "Built on core primitives")

Rel(tooling, core, "Builds packages")
Rel(tooling, compiler, "Builds packages")
Rel(tooling, compilerCli, "Builds packages")
Rel(adevApp, core, "Uses framework")
Rel(adevApp, router, "Uses framework")

Rel(core, npm, "Published")
Rel(compiler, npm, "Published")
Rel(compilerCli, npm, "Published")
Rel(common, npm, "Published")
Rel(router, npm, "Published")
Rel(forms, npm, "Published")
Rel(platformBrowser, npm, "Published")
Rel(platformServer, npm, "Published")
Rel(others, npm, "Published")

Rel(platformBrowser, browser, "DOM / events")
Rel(platformServer, node, "SSR render")

SHOW_LEGEND()
@enduml
