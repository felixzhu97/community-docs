@startuml Spring_AI_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title 容器图 — Spring AI

Person(dev, "应用开发者", "消费 Spring AI 的开发者。")
System_Ext(springApp, "Spring 应用", "装配 Starters 或直接依赖核心模块。")

System_Boundary(springAi, "Spring AI 框架") {

    Container(starters, "Boot Starters", "Maven POM", "opinionated 依赖聚合；拉入 Auto-Configuration、实现与 spring-boot-starter。")
    Container(autoConfig, "Boot Auto-Configurations", "Spring Boot", "按特性拆分的 @AutoConfiguration；依赖多为 optional。")

    Container(commons, "Commons", "Java / spring-ai-commons", "Document、ETL Reader/Transformer/Writer、Observation 约定。")
    Container(modelApi, "Model API", "Java / spring-ai-model", "ChatModel、EmbeddingModel、Image/Audio/Moderation、ToolCalling、ChatMemory、Prompt。")
    Container(clientChat, "ChatClient & Advisors", "Java / spring-ai-client-chat + advisors", "流式 Fluent API、Advisor 链、内置 Memory/ToolCalling Advisors。")
    Container(vectorApi, "Vector Store API", "Java / spring-ai-vector-store", "VectorStore、元数据 Filter、Observation。")
    Container(rag, "RAG", "Java / spring-ai-rag", "模块化检索增强：Query 变换、Retriever、Augmenter、RetrievalAugmentationAdvisor。")
    Container(mcp, "MCP", "Java / mcp/*", "MCP ↔ ToolCallback 桥接、Annotations、WebMVC/WebFlux Transport。")
    Container(docReaders, "Document Readers", "Java / document-readers/*", "Tika、PDF、Markdown、Jsoup 等文档读取实现。")
    Container(modelAdapters, "Model Provider Adapters", "Java / models/*", "各 LLM 提供商的 ChatModel / EmbeddingModel 等实现。")
    Container(vsAdapters, "Vector Store Adapters", "Java / vector-stores/*", "各向量库的 VectorStore 实现。")
    Container(memRepos, "Chat Memory Repositories", "Java / memory-repositories/*", "ChatMemoryRepository 持久化实现。")
}

System_Ext(llmProviders, "LLM / 多模态提供商", "OpenAI, Anthropic, Bedrock, Ollama 等。")
SystemDb_Ext(vectorDbs, "向量数据库", "PGVector, Pinecone, Chroma 等。")
SystemDb_Ext(memoryDbs, "记忆存储", "JDBC / Redis / MongoDB 等。")
System_Ext(mcpExt, "外部 MCP Servers", "远程或本地 MCP 进程。")
System_Ext(obs, "可观测性后端", "Micrometer / OTLP。")

Rel(dev, springApp, "构建应用")
Rel(springApp, starters, "依赖 Starter（推荐）")
Rel(springApp, autoConfig, "或直接依赖 Auto-Configuration")
Rel(springApp, clientChat, "也可无 Boot 使用核心 API")

Rel(starters, autoConfig, "引入")
Rel(autoConfig, modelAdapters, "装配 Beans")
Rel(autoConfig, vsAdapters, "装配 Beans")
Rel(autoConfig, memRepos, "装配 Beans")
Rel(autoConfig, mcp, "装配 MCP Client/Server")
Rel(autoConfig, clientChat, "装配 ChatClient")

Rel(modelAdapters, modelApi, "实现")
Rel(vsAdapters, vectorApi, "实现")
Rel(memRepos, modelApi, "实现 ChatMemoryRepository")
Rel(docReaders, commons, "实现 DocumentReader")

Rel(clientChat, modelApi, "使用 ChatModel / Tools / Memory")
Rel(vectorApi, modelApi, "使用 EmbeddingModel")
Rel(vectorApi, commons, "Document / DocumentWriter")
Rel(rag, clientChat, "Advisor")
Rel(rag, vectorApi, "检索")
Rel(mcp, modelApi, "ToolCallback")
Rel(modelApi, commons, "Document / Observation")
Rel(commons, obs, "Observation 约定", "Micrometer")

Rel(modelAdapters, llmProviders, "HTTP / SDK")
Rel(vsAdapters, vectorDbs, "Provider API")
Rel(memRepos, memoryDbs, "SQL / Driver")
Rel(mcp, mcpExt, "MCP Transport")

SHOW_LEGEND()
@enduml
