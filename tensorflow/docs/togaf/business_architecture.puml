@startuml TensorFlow业务架构图
!theme plain
skinparam componentStyle rectangle
skinparam linetype ortho

title TensorFlow业务架构图 (TOGAF Business Architecture)

package "业务价值主张" {
  [机器学习平台] as MLPlatform
  [研究和开发支持] as RDSupport
  [生产部署能力] as ProductionDeploy
}

package "用户角色" {
  [研究人员] as Researcher
  [开发者] as Developer
  [数据科学家] as DataScientist
  [企业用户] as EnterpriseUser
}

package "业务流程" {
  [模型开发] as ModelDevelopment
  [模型训练] as ModelTraining
  [模型部署] as ModelDeployment
  [模型推理] as ModelInference
}

package "业务能力" {
  [深度学习能力] as DeepLearning
  [分布式训练能力] as DistributedTraining
  [模型优化能力] as ModelOptimization
  [跨平台部署能力] as CrossPlatformDeploy
  [实时推理能力] as RealTimeInference
  [模型管理能力] as ModelManagement
}

' 业务价值与用户角色的关系
MLPlatform --> Researcher
MLPlatform --> Developer
MLPlatform --> DataScientist
MLPlatform --> EnterpriseUser

RDSupport --> Researcher
RDSupport --> Developer
RDSupport --> DataScientist

ProductionDeploy --> EnterpriseUser
ProductionDeploy --> Developer

' 用户角色与业务流程的关系
Researcher --> ModelDevelopment
Researcher --> ModelTraining
Developer --> ModelDevelopment
Developer --> ModelTraining
Developer --> ModelDeployment
DataScientist --> ModelDevelopment
DataScientist --> ModelTraining
DataScientist --> ModelInference
EnterpriseUser --> ModelDeployment
EnterpriseUser --> ModelInference

' 业务流程与业务能力的关系
ModelDevelopment --> DeepLearning
ModelTraining --> DeepLearning
ModelTraining --> DistributedTraining
ModelTraining --> ModelOptimization
ModelDeployment --> CrossPlatformDeploy
ModelDeployment --> ModelManagement
ModelInference --> RealTimeInference
ModelInference --> CrossPlatformDeploy

' 业务能力之间的依赖关系
DistributedTraining --> DeepLearning
ModelOptimization --> DeepLearning
CrossPlatformDeploy --> ModelManagement
RealTimeInference --> ModelOptimization

note right of MLPlatform
  TensorFlow提供端到端的
  机器学习平台能力
end note

note right of DistributedTraining
  支持多GPU、多节点
  分布式训练
end note

note right of CrossPlatformDeploy
  支持服务器、移动端、
  边缘设备和Web部署
end note

@enduml

