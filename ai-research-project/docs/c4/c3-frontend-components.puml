@startuml c3-frontend-components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title AI研究平台 - 前端组件图 (C3)

System_Boundary(Angular, "Angular Web应用") {
    ' 页面组件
    Component(DocumentsComponent, "DocumentsComponent", "文档管理主组件")
    Component(DocumentUploadComponent, "DocumentUploadComponent", "文档上传组件")
    Component(DocumentListComponent, "DocumentListComponent", "文档列表组件")
    Component(DocumentSearchComponent, "DocumentSearchComponent", "文档搜索组件")
    Component(DocumentQAComponent, "DocumentQAComponent", "文档问答组件")
    Component(ChatComponent, "ChatComponent", "聊天组件")
    Component(ModelsPageComponent, "ModelsPageComponent", "模型管理页面")

    ' Services
    Component(ChatService, "ChatService", "聊天API服务")
    Component(DocumentService, "DocumentService", "文档API服务")
    Component(ModelService, "ModelService", "模型API服务")

    ' Models/Interfaces
    Component(DocumentTypes, "Document Types", "文档相关TypeScript接口")
    Component(ChatModels, "Chat Models", "聊天相关TypeScript接口")
    Component(ModelInterfaces, "Model Interfaces", "模型相关TypeScript接口")
}

' 外部系统
Component(SpringBootAPI, "Spring Boot API", "后端REST API")

' 组件关系 - 文档功能
Rel(DocumentsComponent, DocumentUploadComponent, "包含")
Rel(DocumentsComponent, DocumentListComponent, "包含")
Rel(DocumentsComponent, DocumentSearchComponent, "包含")
Rel(DocumentsComponent, DocumentQAComponent, "包含")

Rel(DocumentUploadComponent, DocumentService, "调用")
Rel(DocumentListComponent, DocumentService, "调用")
Rel(DocumentSearchComponent, DocumentService, "调用")
Rel(DocumentQAComponent, DocumentService, "调用")

Rel(DocumentService, DocumentTypes, "使用")

' 组件关系 - 聊天功能
Rel(ChatComponent, ChatService, "调用")
Rel(ChatService, ChatModels, "使用")

' 组件关系 - 模型管理
Rel(ModelsPageComponent, ModelService, "调用")
Rel(ModelService, ModelInterfaces, "使用")

' API 调用
Rel(ChatService, SpringBootAPI, "HTTP请求")
Rel(DocumentService, SpringBootAPI, "HTTP请求")
Rel(ModelService, SpringBootAPI, "HTTP请求")

SHOW_LEGEND()

@enduml
