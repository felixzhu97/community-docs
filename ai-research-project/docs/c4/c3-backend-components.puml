@startuml c3-backend-components
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title AI研究平台 - 后端组件图 (C3)

System_Boundary(SpringBoot, "Spring Boot 后端") {
    ' Controllers
    Component(ChatController, "ChatController", "处理聊天请求")
    Component(DocumentController, "DocumentController", "处理文档上传、搜索、问答")
    Component(ModelController, "ModelController", "管理AI模型配置")

    ' Services
    Component(ChatService, "ChatService", "聊天业务逻辑")
    Component(DocumentService, "DocumentService", "文档处理业务逻辑")
    Component(ModelService, "ModelService", "模型管理业务逻辑")

    ' AI Integration
    Component(AIModelSelector, "AIModelSelector", "AI模型选择器")
    Component(ChatClientConfig, "ChatClientConfig", "AI客户端配置")

    ' Models
    Component(ChatRequest, "ChatRequest", "聊天请求模型")
    Component(ChatResponse, "ChatResponse", "聊天响应模型")
    Component(Message, "Message", "消息模型")
    Component(Document, "Document", "文档模型")
    Component(DocumentQuestionRequest, "DocumentQuestionRequest", "文档问答请求")
    Component(DocumentQuestionResponse, "DocumentQuestionResponse", "文档问答响应")
    Component(ModelInfo, "ModelInfo", "模型信息模型")
}

' 外部依赖
Component(AI模型服务, "AI模型服务", "OpenAI, Anthropic, Google, Azure, Ollama")

' 内部连接
Rel(ChatController, ChatService, "调用")
Rel(DocumentController, DocumentService, "调用")
Rel(ModelController, ModelService, "调用")

Rel(ChatService, AIModelSelector, "使用")
Rel(ChatService, ChatClientConfig, "使用")

Rel(DocumentService, AIModelSelector, "使用")

Rel(ChatService, Message, "处理")
Rel(ChatService, ChatRequest, "接收")
Rel(ChatService, ChatResponse, "返回")

Rel(DocumentService, Document, "处理")
Rel(DocumentService, DocumentQuestionRequest, "接收")
Rel(DocumentService, DocumentQuestionResponse, "返回")

Rel(ModelService, ModelInfo, "处理")

' 外部连接
Rel(AIModelSelector, AI模型服务, "调用AI模型API")

SHOW_LEGEND()

@enduml
