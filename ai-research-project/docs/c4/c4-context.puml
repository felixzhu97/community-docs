@startuml c4-context
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

title AI研究平台 - 系统上下文图 (C1)

' 人员边界
Person(研究人员, "研究人员", "使用平台进行AI研究的专业人员")
Person(用户, "普通用户", "使用平台进行文档问答和聊天的用户")

' 外部系统
System_Ext(AI模型API, "AI模型服务API", "外部AI模型服务提供商", $sprite="robot")
System_Ext(OpenAI, "OpenAI API", "GPT-4o 等模型")
System_Ext(Anthropic, "Anthropic API", "Claude 等模型")
System_Ext(GoogleAI, "Google AI API", "Gemini 等模型")
System_Ext(AzureOpenAI, "Azure OpenAI", "Azure托管的OpenAI模型")
System_Ext(Ollama, "Ollama本地模型", "本地运行的LLM模型")

' 核心系统
System(AIResearchPlatform, "AI研究平台", "整合文档管理、聊天和模型管理的一体化平台")

' 关系定义
Rel(研究人员, AIResearchPlatform, "管理AI模型")
Rel(用户, AIResearchPlatform, "上传文档、提问、聊天")

Rel(AIResearchPlatform, OpenAI, "调用")
Rel(AIResearchPlatform, Anthropic, "调用")
Rel(AIResearchPlatform, GoogleAI, "调用")
Rel(AIResearchPlatform, AzureOpenAI, "调用")
Rel(AIResearchPlatform, Ollama, "调用")

' 添加 AI模型API 作为聚合节点
Rel(OpenAI, AI模型API, "属于")
Rel(Anthropic, AI模型API, "属于")
Rel(GoogleAI, AI模型API, "属于")
Rel(AzureOpenAI, AI模型API, "属于")
Rel(Ollama, AI模型API, "属于")

SHOW_LEGEND()

@enduml
