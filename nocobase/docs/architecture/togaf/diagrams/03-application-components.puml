@startuml
title NocoBase TOGAF Pack - Application Architecture (Components)

skinparam componentStyle rectangle
skinparam shadowing false

legend right
View: Application Architecture
Focus: Runtime components and plugin boundary
End legend

actor "Browser User" as User
actor "Automation Client" as Automation
actor "Plugin Developer" as PluginDev

rectangle "Client Layer" as ClientLayer {
  component "Web Client" as WebClient
}

rectangle "Edge Layer" as EdgeLayer {
  component "Gateway" as Gateway
  component "Reverse Proxy (optional)" as ReverseProxy
}

rectangle "Server Layer" as ServerLayer {
  component "App Server" as AppServer
  component "Auth" as Auth
  component "ACL/RBAC" as ACL
  component "API Router" as ApiRouter
  component "Workflow Engine" as Workflow
  component "Job Runner" as JobRunner
  component "Plugin Manager" as PluginManager
  component "Plugin Runtime" as PluginRuntime
  component "Data Source Manager" as DataSourceManager
  component "File Service" as FileService
  component "Audit Logger" as Audit
}

database "Primary Database" as PrimaryDB
cloud "External Services" as ExternalServices

User --> WebClient
Automation --> Gateway : REST API

WebClient --> ReverseProxy
ReverseProxy --> Gateway
WebClient --> Gateway : HTTP + WebSocket

Gateway --> ApiRouter
ApiRouter --> Auth
ApiRouter --> ACL
ApiRouter --> AppServer

AppServer --> PluginManager
PluginManager --> PluginRuntime : load/enable/disable
PluginDev --> PluginRuntime : extend by plugins

PluginRuntime --> DataSourceManager
DataSourceManager --> PrimaryDB

PluginRuntime --> Workflow
Workflow --> JobRunner

PluginRuntime --> FileService
PluginRuntime --> Audit

PluginRuntime --> ExternalServices : integrations

@enduml
