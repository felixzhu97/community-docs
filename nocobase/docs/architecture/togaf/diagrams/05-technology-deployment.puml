@startuml
title NocoBase TOGAF Pack - Technology Architecture (Deployment)

skinparam shadowing false

legend right
View: Technology Architecture
Focus: Typical deployment nodes and dependencies
End legend

node "User Device" as UserDevice {
  artifact "Browser" as Browser
}

node "Edge" as Edge {
  artifact "Reverse Proxy (Nginx)" as Nginx
}

node "Application Host" as AppHost {
  artifact "Node.js Runtime" as NodeRuntime
  artifact "NocoBase App Server" as AppServer
  artifact "Static Assets" as StaticAssets
}

node "Data Host" as DataHost {
  database "PostgreSQL/MySQL" as Database
  artifact "Redis (optional)" as Redis
}

cloud "External Providers" as Providers {
  artifact "OIDC/SAML IdP" as IdP
  artifact "Object Storage" as ObjectStorage
  artifact "Email/SMS" as Notifier
  artifact "External APIs" as ExternalAPIs
}

Browser --> Nginx : HTTPS
Nginx --> StaticAssets : HTTP
Nginx --> AppServer : HTTP/WebSocket

AppServer --> Database : SQL
AppServer --> Redis : cache/queue

AppServer --> IdP : auth
AppServer --> ObjectStorage : files
AppServer --> Notifier : notifications
AppServer --> ExternalAPIs : integration

NodeRuntime -down- AppServer
StaticAssets -down- AppServer

@enduml
