@startuml ReactNative_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title 容器图 — React Native

Person(dev, "应用开发者", "消费 react-native 与工具包。")
System_Ext(app, "应用工程", "JS 入口 + android/ / ios/ 原生工程。")

System_Boundary(mono, "facebook/react-native monorepo") {

    Container(rnJs, "react-native JS", "JavaScript / packages/react-native", "Libraries/、index.js：组件、API、原生模块 JS 面。")
    Container(reactApple, "ReactApple / React", "Objective-C++ / packages/react-native/React*", "iOS 运行时：Core、Fabric、Modules 等。")
    Container(reactAndroid, "ReactAndroid", "Java/Kotlin/C++ / packages/react-native/ReactAndroid", "Android 运行时与 Gradle 集成。")
    Container(reactCommon, "ReactCommon", "C++ / packages/react-native/ReactCommon", "jsi、cxxreact、renderer（Fabric）、yoga、hermes、nativemodule 等。")
    Container(codegen, "react-native-codegen", "JavaScript / packages/react-native-codegen", "新架构规格代码生成。")
    Container(cliPlugins, "CLI / Metro 包", "JavaScript", "community-cli-plugin、metro-config、dev-middleware、babel-* 等。")
    Container(rnTester, "rn-tester", "应用 / packages/rn-tester", "内部测试与演示应用。")
    Container(tooling, "构建工具链", "Yarn / Gradle / CocoaPods", "根 Gradle、scripts、podspecs。")
}

System_Ext(metro, "Metro 打包器", "开发与发布 JS bundle。")
System_Ext(hermes, "Hermes 引擎", "执行 JS。")
System_Ext(npm, "npm", "制品分发。")

Rel(dev, app, "开发产品应用")
Rel(app, rnJs, "导入组件与 API")
Rel(app, reactApple, "iOS 链接原生")
Rel(app, reactAndroid, "Android 链接原生")
Rel(app, metro, "打包 JS")
Rel(metro, rnJs, "解析模块图")

Rel(rnJs, reactCommon, "经 JSI / 原生模块调用")
Rel(reactApple, reactCommon, "使用共享 C++ 运行时")
Rel(reactAndroid, reactCommon, "使用共享 C++ 运行时")
Rel(reactCommon, hermes, "执行 JS")
Rel(codegen, rnJs, "生成 TurboModule / 组件规格绑定")
Rel(cliPlugins, metro, "集成开发服务器与配置")

Rel(tooling, reactAndroid, "构建 AAR / 原生")
Rel(tooling, reactApple, "构建 Pods")
Rel(rnTester, rnJs, "验证功能")
Rel(rnJs, npm, "发布")

SHOW_LEGEND()
@enduml
