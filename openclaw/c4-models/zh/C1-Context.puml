@startuml C1-Context
!include ../lib/C4_Context.puml

LAYOUT_WITH_LEGEND()

title OpenClaw 系统上下文图

' 参与者
Person(user, "用户", "通过消息平台与 AI Agent 交互的最终用户")
Person(developer, "开发者", "创建插件以扩展 OpenClaw 功能")
Person(operator, "运维人员", "管理 OpenClaw 安装、配置和监控")

' OpenClaw 系统边界
System_Boundary(openclaw, "OpenClaw") {
    System(openclaw_system, "OpenClaw", "基于插件架构的 AI Agent 运行时\n支持 135+ 插件：渠道、提供商、工具、记忆和语音")
}

' 外部系统 - AI 提供商
System_Boundary(ai_providers, "AI 提供商") {
    System_Ext(openai, "OpenAI", "GPT 模型 API")
    System_Ext(anthropic, "Anthropic", "Claude 模型 API")
    System_Ext(google, "Google", "Gemini 模型 API")
    System_Ext(deepseek, "DeepSeek", "DeepSeek 模型 API")
    System_Ext(mistral, "Mistral AI", "Mistral 模型 API")
    System_Ext(groq, "Groq", "快速推理 API")
    System_Ext(ollama, "Ollama", "本地模型推理")
    System_Ext(openrouter, "OpenRouter", "统一模型访问")
}

' 外部系统 - 消息平台（渠道插件）
System_Boundary(messaging_platforms, "消息平台") {
    System_Ext(discord, "Discord", "Discord 消息平台")
    System_Ext(telegram, "Telegram", "Telegram 消息平台")
    System_Ext(slack, "Slack", "Slack 工作区")
    System_Ext(msteams, "MS Teams", "Microsoft Teams")
    System_Ext(whatsapp, "WhatsApp", "WhatsApp 消息")
    System_Ext(matrix, "Matrix", "Matrix 协议")
    System_Ext(feishu, "飞书", "飞书/ Lark 消息")
}

' 外部系统 - MCP 服务器
System_Ext(mcp_servers, "MCP 服务器", "用于工具集成的 Model Context Protocol 服务器")

' 外部系统 - ClawHub
System_Ext(clawhub, "ClawHub", "官方插件注册表和目录")

' 外部系统 - 存储
System_Ext(storage, "文件系统", "本地存储：~/.openclaw/\n配置、凭据、Agent、会话")

' 用户关系
Rel(user, discord, "与 AI Agent 聊天")
Rel(user, telegram, "与 AI Agent 聊天")
Rel(user, slack, "与 AI Agent 聊天")
Rel(user, whatsapp, "与 AI Agent 聊天")

' 开发者关系
Rel(developer, openclaw_system, "开发插件")
Rel(developer, clawhub, "发布插件")

' 运维人员关系
Rel(operator, openclaw_system, "配置和监控")
Rel(operator, storage, "管理数据")

' OpenClaw 到 AI 提供商
Rel(openclaw_system, openai, "调用 GPT 模型")
Rel(openclaw_system, anthropic, "调用 Claude 模型")
Rel(openclaw_system, google, "调用 Gemini 模型")
Rel(openclaw_system, deepseek, "调用 DeepSeek 模型")
Rel(openclaw_system, mistral, "调用 Mistral 模型")
Rel(openclaw_system, ollama, "调用本地模型")

' OpenClaw 到消息平台
Rel(openclaw_system, discord, "接收/发送消息")
Rel(openclaw_system, telegram, "接收/发送消息")
Rel(openclaw_system, slack, "接收/发送消息")
Rel(openclaw_system, msteams, "接收/发送消息")
Rel(openclaw_system, whatsapp, "接收/发送消息")
Rel(openclaw_system, feishu, "接收/发送消息")

' OpenClaw 到 MCP 服务器
Rel(openclaw_system, mcp_servers, "通过 MCP 协议使用工具")

' OpenClaw 到 ClawHub
Rel(openclaw_system, clawhub, "发现和安装插件")

' OpenClaw 到存储
Rel(openclaw_system, storage, "读写配置、凭据、会话")

SHOW_LEGEND()
@enduml
