@startuml C3-Core-Components
!include ../lib/C4_Component.puml

LAYOUT_WITH_LEGEND()

title OpenClaw 核心组件图

' 容器上下文
Container(openclaw, "OpenClaw", "Node.js", "基于插件架构的 AI Agent 运行时")

' Gateway 组件
Container_Boundary(gateway, "Gateway 网关") {
    Component(gw_server, "GatewayServer", "Node.js", "HTTP/WebSocket 服务器\nserver.impl.ts")
    Component(gw_health, "HealthState", "TypeScript", "健康检查和状态")
    Component(gw_protocol, "ProtocolHandler", "TypeScript", "网关协议\nprotocol/*.ts")
    Component(gw_router, "MethodRegistry", "TypeScript", "RPC 方法注册表")
    Component(gw_channel_mgr, "ChannelManager", "TypeScript", "渠道路由")
    Component(gw_auth, "AuthHandler", "TypeScript", "认证处理")
}

' Agent 运行时组件
Container_Boundary(agent, "Agent 运行时") {
    Component(agent_runner, "EmbeddedRunner", "TypeScript", "Agent 执行引擎\npi-embedded-runner/runtime.ts")
    Component(agent_selector, "ModelSelector", "TypeScript", "模型选择")
    Component(agent_executor, "ToolExecutor", "TypeScript", "工具调用")
    Component(agent_context, "ContextManager", "TypeScript", "提示词上下文")
    Component(agent_session, "SessionManager", "TypeScript", "对话会话\nsrc/sessions/")
}

' 插件系统组件
Container_Boundary(plugins, "插件系统") {
    Component(plugin_registry, "PluginRegistry", "TypeScript", "插件元数据\nregistry.ts")
    Component(plugin_loader, "RuntimeLoader", "TypeScript", "动态加载\nruntime/index.ts")
    Component(plugin_manifest, "ManifestParser", "TypeScript", "清单验证")
    Component(plugin_capability, "CapabilityContracts", "TypeScript", "能力契约")
}

' 渠道层组件
Container_Boundary(channel, "渠道层") {
    Component(ch_dispatcher, "MessageDispatcher", "TypeScript", "消息路由\nsrc/channels/")
    Component(ch_handler, "TurnKernel", "TypeScript", "轮次处理")
    Component(ch_transformer, "MessageTransformer", "TypeScript", "格式转换")
}

' 配置系统组件
Container_Boundary(config, "配置系统") {
    Component(cfg_loader, "ConfigLoader", "TypeScript", "配置加载\nsrc/config/")
    Component(cfg_validator, "ConfigValidator", "Zod", "模式验证")
    Component(cfg_store, "ConfigStore", "TypeScript", "配置存储")
}

' 安全组件
Container_Boundary(security, "安全") {
    Component(sec_credential, "CredentialsStore", "TypeScript", "安全存储\nsrc/secrets/")
    Component(sec_auth, "AuthProfiles", "TypeScript", "提供商认证")
}

' SDK 组件
Container_Boundary(sdk, "SDK") {
    Component(sdk_plugin, "PluginSDK", "TypeScript", "插件 SDK\npackages/plugin-sdk/")
    Component(sdk_runtime, "RuntimeHelpers", "TypeScript", "注入的工具函数")
}

' Gateway 内部关系
Rel(gw_server, gw_health, "健康检查")
Rel(gw_server, gw_protocol, "协议")
Rel(gw_server, gw_router, "方法")
Rel(gw_router, gw_channel_mgr, "渠道")
Rel(gw_channel_mgr, gw_auth, "认证")

' Gateway 到 Agent
Rel(gw_protocol, agent_runner, "执行")

' Agent 内部关系
Rel(agent_runner, agent_selector, "选择模型")
Rel(agent_runner, agent_executor, "执行工具")
Rel(agent_runner, agent_context, "上下文")
Rel(agent_runner, agent_session, "会话")

' 插件系统关系
Rel(plugin_loader, plugin_registry, "注册")
Rel(plugin_loader, plugin_manifest, "验证")
Rel(plugin_manifest, plugin_capability, "契约")

' 渠道关系
Rel(ch_dispatcher, ch_handler, "调度")
Rel(ch_handler, ch_transformer, "转换")

' 配置关系
Rel(cfg_loader, cfg_validator, "验证")
Rel(cfg_loader, cfg_store, "存储")

' 安全关系
Rel(sec_credential, sec_auth, "配置文件")

' 外部集成
Rel(gw_channel_mgr, channel, "渠道插件")
Rel(agent_executor, plugin_capability, "工具")
Rel(agent_selector, sdk_plugin, "提供商插件")

SHOW_LEGEND()
@enduml
