@startuml C3-Core-Components
!include ../lib/C4_Component.puml

LAYOUT_WITH_LEGEND()

title OpenClaw Core Components Diagram

' Container context
Container(openclaw, "OpenClaw", "Node.js", "AI Agent Runtime with Plugin Architecture")

' Gateway Components
Container_Boundary(gateway, "Gateway") {
    Component(gw_server, "GatewayServer", "Node.js", "HTTP/WebSocket server\nserver.impl.ts")
    Component(gw_health, "HealthState", "TypeScript", "Health check and status")
    Component(gw_protocol, "ProtocolHandler", "TypeScript", "Gateway protocol\nprotocol/*.ts")
    Component(gw_router, "MethodRegistry", "TypeScript", "RPC method registry")
    Component(gw_channel_mgr, "ChannelManager", "TypeScript", "Channel routing")
    Component(gw_auth, "AuthHandler", "TypeScript", "Authentication")
}

' Agent Runtime Components
Container_Boundary(agent, "Agent Runtime") {
    Component(agent_runner, "EmbeddedRunner", "TypeScript", "Agent execution\npi-embedded-runner/runtime.ts")
    Component(agent_selector, "ModelSelector", "TypeScript", "Model selection")
    Component(agent_executor, "ToolExecutor", "TypeScript", "Tool invocation")
    Component(agent_context, "ContextManager", "TypeScript", "Prompt context")
    Component(agent_session, "SessionManager", "TypeScript", "Conversation sessions\nsrc/sessions/")
}

' Plugin System Components
Container_Boundary(plugins, "Plugin System") {
    Component(plugin_registry, "PluginRegistry", "TypeScript", "Plugin metadata\nregistry.ts")
    Component(plugin_loader, "RuntimeLoader", "TypeScript", "Dynamic loading\nruntime/index.ts")
    Component(plugin_manifest, "ManifestParser", "TypeScript", "Manifest validation")
    Component(plugin_capability, "CapabilityContracts", "TypeScript", "Capability contracts")
}

' Channel Layer Components
Container_Boundary(channel, "Channel Layer") {
    Component(ch_dispatcher, "MessageDispatcher", "TypeScript", "Message routing\nsrc/channels/")
    Component(ch_handler, "TurnKernel", "TypeScript", "Turn processing")
    Component(ch_transformer, "MessageTransformer", "TypeScript", "Format conversion")
}

' Config System Components
Container_Boundary(config, "Config System") {
    Component(cfg_loader, "ConfigLoader", "TypeScript", "Config loading\nsrc/config/")
    Component(cfg_validator, "ConfigValidator", "Zod", "Schema validation")
    Component(cfg_store, "ConfigStore", "TypeScript", "Config storage")
}

' Security Components
Container_Boundary(security, "Security") {
    Component(sec_credential, "CredentialsStore", "TypeScript", "Secure storage\nsrc/secrets/")
    Component(sec_auth, "AuthProfiles", "TypeScript", "Provider auth")
}

' SDK Components
Container_Boundary(sdk, "SDK") {
    Component(sdk_plugin, "PluginSDK", "TypeScript", "Plugin SDK\npackages/plugin-sdk/")
    Component(sdk_runtime, "RuntimeHelpers", "TypeScript", "Injected utilities")
}

' Gateway internal relationships
Rel(gw_server, gw_health, "Health check")
Rel(gw_server, gw_protocol, "Protocol")
Rel(gw_server, gw_router, "Methods")
Rel(gw_router, gw_channel_mgr, "Channels")
Rel(gw_channel_mgr, gw_auth, "Auth")

' Gateway to Agent
Rel(gw_protocol, agent_runner, "Execute")

' Agent internal relationships
Rel(agent_runner, agent_selector, "Select model")
Rel(agent_runner, agent_executor, "Execute tools")
Rel(agent_runner, agent_context, "Context")
Rel(agent_runner, agent_session, "Sessions")

' Plugin System relationships
Rel(plugin_loader, plugin_registry, "Register")
Rel(plugin_loader, plugin_manifest, "Validate")
Rel(plugin_manifest, plugin_capability, "Contracts")

' Channel relationships
Rel(ch_dispatcher, ch_handler, "Dispatch")
Rel(ch_handler, ch_transformer, "Transform")

' Config relationships
Rel(cfg_loader, cfg_validator, "Validate")
Rel(cfg_loader, cfg_store, "Store")

' Security relationships
Rel(sec_credential, sec_auth, "Profiles")

' External integrations
Rel(gw_channel_mgr, channel, "Channel plugins")
Rel(agent_executor, plugin_capability, "Tools")
Rel(agent_selector, sdk_plugin, "Provider plugins")

SHOW_LEGEND()
@enduml
