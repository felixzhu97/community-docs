@startuml SpringSecurity_SystemContext
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

LAYOUT_WITH_LEGEND()

title 系统上下文图 — Spring Security

Person(endUser, "终端用户", "通过宿主应用访问受保护资源。")
Person(developer, "应用开发者", "集成并配置 Spring Security。")

System(springSecurity, "Spring Security", "认证、授权与攻击防护；Spring Security 7 起内含 OAuth2 Authorization Server（原独立项目）。")

System_Ext(hostApp, "宿主 Spring 应用", "嵌入 Spring Security 的业务应用（MVC / WebFlux）；亦可作为授权服务器宿主。")
System_Ext(runtime, "运行时容器", "Servlet 容器（Tomcat/Jetty）或 Netty（WebFlux）。")
System_Ext(oauth2Idp, "外部 OAuth2 / OIDC IdP", "第三方授权服务器 / OpenID Provider（Client / Resource Server 模式）。")
System_Ext(oauth2Client, "外部 OAuth2 Client", "当宿主启用 Authorization Server 时的调用方。")
System_Ext(saml2Idp, "SAML 2.0 IdP", "SAML 身份提供者。")
System_Ext(casServer, "CAS Server", "中央认证服务（SSO）。")
System_Ext(ldap, "LDAP 目录", "用户与组目录（如 Active Directory / OpenLDAP）。")
System_Ext(kdc, "Kerberos KDC", "密钥分发中心（SPNEGO）。")
System_Ext(userStore, "用户 / ACL / 授权存储", "JDBC 用户库、Remember-Me、ACL、RegisteredClient / Authorization。")
System_Ext(webauthn, "WebAuthn Authenticator", "通行密钥 / 安全密钥设备。")
System_Ext(rsocketClient, "RSocket / WebSocket 客户端", "消息与双向通信客户端。")

Rel(endUser, hostApp, "使用", "HTTPS")
Rel(developer, springSecurity, "配置与扩展", "Java/Kotlin DSL / XML")
Rel(hostApp, springSecurity, "嵌入并调用", "JAR / API")
Rel(hostApp, runtime, "部署于")
Rel(springSecurity, runtime, "挂载 Filter / WebFilter")

Rel(springSecurity, oauth2Idp, "Client / RS：授权码 / Token / OIDC", "HTTPS")
Rel(oauth2Client, springSecurity, "AS：/oauth2/authorize、/oauth2/token、JWKS", "HTTPS")
Rel(springSecurity, saml2Idp, "SAML AuthnRequest / Response", "HTTPS")
Rel(springSecurity, casServer, "CAS 票据验证", "HTTPS")
Rel(springSecurity, ldap, "绑定 / 搜索用户", "LDAP(S)")
Rel(springSecurity, kdc, "票据获取 / 验证", "Kerberos")
Rel(springSecurity, userStore, "读写用户、ACL 与 AS 状态", "JDBC / SQL")
Rel(springSecurity, webauthn, "注册与断言", "WebAuthn")
Rel(rsocketClient, hostApp, "安全消息", "RSocket / STOMP")

SHOW_LEGEND()
@enduml
