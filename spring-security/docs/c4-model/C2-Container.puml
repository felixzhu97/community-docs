@startuml SpringSecurity_Containers
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

LAYOUT_WITH_LEGEND()

title 容器图 (C2) — Spring Security 发布模块

Person(developer, "应用开发者", "集成 Spring Security 模块")
System_Ext(hostApp, "宿主 Spring 应用", "业务应用，按需依赖各模块 JAR")

System_Boundary(ss, "Spring Security") {
    Container(crypto, "Crypto", "Java JAR", "spring-security-crypto：密码哈希与加密原语")
    Container(core, "Core", "Java JAR", "spring-security-core：认证、授权、SecurityContext、用户模型")
    Container(web, "Web", "Java JAR", "spring-security-web：Servlet Filter 链与 Reactive WebFilter")
    Container(config, "Config", "Java JAR", "spring-security-config：Java/XML/Kotlin DSL 配置")
    Container(oauth2Core, "OAuth2 Core", "Java JAR", "spring-security-oauth2-core：OAuth2/OIDC 核心模型")
    Container(oauth2Jose, "OAuth2 JOSE", "Java JAR", "spring-security-oauth2-jose：JWT / JWS / JWK")
    Container(oauth2Client, "OAuth2 Client", "Java JAR", "spring-security-oauth2-client：OAuth2/OIDC 客户端")
    Container(oauth2Rs, "OAuth2 Resource Server", "Java JAR", "spring-security-oauth2-resource-server：Bearer Token 保护 API")
    Container(oauth2As, "OAuth2 Authorization Server", "Java JAR", "spring-security-oauth2-authorization-server：授权服务器")
    Container(saml2, "SAML2 SP", "Java JAR", "spring-security-saml2-service-provider：SAML2 依赖方")
    Container(ldap, "LDAP", "Java JAR", "spring-security-ldap：LDAP 认证与用户管理")
    Container(cas, "CAS", "Java JAR", "spring-security-cas：CAS 客户端集成")
    Container(kerberos, "Kerberos", "Java JAR", "spring-security-kerberos-*：Kerberos/SPNEGO")
    Container(webauthn, "WebAuthn", "Java JAR", "spring-security-webauthn：通行密钥")
    Container(acl, "ACL", "Java JAR", "spring-security-acl：领域对象 ACL")
    Container(messaging, "Messaging", "Java JAR", "spring-security-messaging：WebSocket/STOMP 安全")
    Container(rsocket, "RSocket", "Java JAR", "spring-security-rsocket：RSocket 安全")
    Container(aspects, "Aspects", "Java JAR", "spring-security-aspects：AspectJ 方法安全")
    Container(data, "Data", "Java JAR", "spring-security-data：Spring Data 集成")
    Container(taglibs, "Taglibs", "Java JAR", "spring-security-taglibs：JSP 安全标签")
    Container(test, "Test", "Java JAR", "spring-security-test：测试支持")
}

System_Ext(oauth2Idp, "OAuth2 / OIDC IdP", "外部身份提供者")
System_Ext(saml2Idp, "SAML 2.0 IdP", "外部 SAML IdP")
System_Ext(casServer, "CAS Server", "外部 CAS")
System_Ext(ldapDir, "LDAP 目录", "外部目录服务")
System_Ext(kdc, "Kerberos KDC", "外部 KDC")
System_Ext(db, "JDBC 存储", "用户 / ACL / Remember-Me")

Rel(developer, config, "配置", "DSL / XML")
Rel(hostApp, config, "依赖（常用入口）")
Rel(hostApp, web, "依赖（Web 安全）")
Rel(hostApp, core, "依赖（方法安全等）")

Rel(config, web, "装配")
Rel(config, core, "装配")
Rel(web, core, "使用")
Rel(core, crypto, "密码编码")
Rel(acl, core, "使用")
Rel(ldap, core, "使用")
Rel(cas, web, "使用")
Rel(cas, core, "使用")
Rel(saml2, web, "使用")
Rel(saml2, core, "使用")
Rel(kerberos, web, "使用")
Rel(kerberos, core, "使用")
Rel(webauthn, web, "使用")
Rel(webauthn, core, "使用")
Rel(oauth2Core, core, "使用")
Rel(oauth2Jose, oauth2Core, "使用")
Rel(oauth2Client, oauth2Core, "使用")
Rel(oauth2Client, oauth2Jose, "JWT/JWK")
Rel(oauth2Client, web, "使用")
Rel(oauth2Rs, oauth2Core, "使用")
Rel(oauth2Rs, oauth2Jose, "JWT")
Rel(oauth2Rs, web, "使用")
Rel(oauth2As, oauth2Core, "使用")
Rel(oauth2As, oauth2Jose, "JWT/JWK")
Rel(messaging, core, "使用")
Rel(rsocket, core, "使用")
Rel(aspects, core, "使用")
Rel(data, core, "使用")
Rel(taglibs, web, "使用")
Rel(test, core, "测试 API")
Rel(test, web, "MockMvc / WebTestClient")

Rel(oauth2Client, oauth2Idp, "OAuth2/OIDC", "HTTPS")
Rel(oauth2Rs, oauth2Idp, "JWKS / introspection", "HTTPS")
Rel(oauth2As, oauth2Idp, "可作为 IdP 暴露端点")
Rel(saml2, saml2Idp, "SAML2", "HTTPS")
Rel(cas, casServer, "CAS", "HTTPS")
Rel(ldap, ldapDir, "LDAP(S)")
Rel(kerberos, kdc, "Kerberos")
Rel(core, db, "JdbcUserDetails / 等（可选）", "JDBC")
Rel(acl, db, "JdbcAclService（可选）", "JDBC")

SHOW_LEGEND()
@enduml
