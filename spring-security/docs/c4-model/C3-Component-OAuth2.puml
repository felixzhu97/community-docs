@startuml SpringSecurity_Component_OAuth2
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title 组件图 — OAuth2 / OIDC 模块

Container_Ext(web, "Web / Config", "Java", "Filter 与 DSL 入口。")
Container_Ext(idp, "OAuth2 / OIDC IdP", "External", "授权、Token、JWKS、UserInfo。")
Container_Ext(nimbus, "Nimbus JOSE / OIDC SDK", "Library", "JWT 解析与 OIDC 协议支持。")

Container_Boundary(oauth2, "OAuth2 模块") {
    Component(oauth2Core, "OAuth2 Core", "oauth2-core", "AuthorizationGrant、ClientRegistration、OidcIdToken 等模型。")
    Component(jose, "OAuth2 JOSE", "oauth2-jose", "JwtDecoder、JwkSet、Jwt 校验。")
    Component(client, "OAuth2 Client", "oauth2-client", "OAuth2Login / AuthorizedClient / 授权码流。")
    Component(oauth2LoginFilter, "OAuth2LoginAuthenticationFilter", "Filter", "处理授权码回调并建立会话。")
    Component(authorizedClientSvc, "OAuth2AuthorizedClientService", "Service", "持久化访问令牌。")
    Component(rs, "Resource Server", "oauth2-resource-server", "BearerTokenAuthenticationFilter / JWT 或 Opaque Token。")
    Component(bearerFilter, "BearerTokenAuthenticationFilter", "Filter", "从请求提取并认证 Bearer Token。")
    Component(as, "Authorization Server", "oauth2-authorization-server", "详见 C3-Component-AuthorizationServer：端点 Filter、RegisteredClient、Token 签发。")
    Component(asEndpoints, "AS Protocol Endpoints", "HTTP Endpoints", "/oauth2/authorize、/oauth2/token、JWKS、OIDC UserInfo 等。")
}

Rel(web, client, "oauth2Login / oauth2Client")
Rel(web, rs, "oauth2ResourceServer")
Rel(web, as, "启用授权服务器")
Rel(client, oauth2Core, "使用模型")
Rel(rs, oauth2Core, "使用模型")
Rel(as, oauth2Core, "使用模型")
Rel(client, jose, "ID Token / JWT（可选）")
Rel(rs, jose, "JwtDecoder")
Rel(as, jose, "签发 JWT / JWKS")
Rel(jose, nimbus, "编解码")
Rel(client, oauth2LoginFilter, "包含")
Rel(client, authorizedClientSvc, "管理令牌")
Rel(rs, bearerFilter, "包含")
Rel(as, asEndpoints, "暴露")
Rel(oauth2LoginFilter, idp, "授权码 / Token / UserInfo", "HTTPS")
Rel(bearerFilter, idp, "JWKS / introspection", "HTTPS")
Rel(asEndpoints, idp, "本模块亦可作为 IdP")

SHOW_LEGEND()
@enduml
