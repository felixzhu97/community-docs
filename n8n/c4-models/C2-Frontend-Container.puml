@startuml C2-Frontend-Container
!include lib/C4_Container.puml

LAYOUT_WITH_LEGEND()

title n8n 前端 - 容器图

Person(user, "用户", "工作流设计者和管理员")

System_Boundary(frontend, "编辑器 UI (packages/editor-ui)") {
    Container(spa, "Vue 3 单页应用", "Vue.js + Vite + Pinia", "响应式工作流编辑器")

    Container_Boundary(views, "视图层") {
        Container(node_view, "NodeView", "工作流编辑器", "主画布，用于设计和执行工作流")
        Container(workflows_view, "WorkflowsView", "工作流列表", "仪表板，搜索和管理工作流")
        Container(settings_view, "SettingsView", "设置页面", "个人设置、用户管理、API 密钥、安全")
        Container(auth_view, "AuthView", "认证页面", "登录、注册、密码重置、MFA")
        Container(executions_view, "ExecutionsView", "执行历史", "运行历史表格和详情")
        Container(credentials_view, "CredentialsView", "凭证管理", "API 凭证的增删改查")
        Container(templates_view, "TemplatesView", "模板市场", "工作流模板浏览和使用")
        Container(projects_view, "ProjectsView", "项目管理", "文件夹和项目结构管理")
        Container(variables_view, "VariablesView", "变量管理", "全局变量配置")
        Container(source_view, "SourceView", "数据源", "外部数据源配置")
        Container(workers_view, "WorkersView", "Worker 管理", "查看 worker 状态和日志")
    }

    Container_Boundary(stores, "Pinia 状态管理") {
        Container(workflows_store, "workflows", "工作流状态", "当前工作流、执行记录、活跃工作流")
        Container(settings_store, "settings", "设置状态", "应用配置、项目设置、功能开关")
        Container(ui_store, "ui", "UI 状态", "模态框、侧边栏、通知、toast 提示")
        Container(node_types_store, "nodeTypes", "节点类型", "可用节点类型、社区节点")
        Container(credentials_store, "credentials", "凭证状态", "所有凭证管理")
        Container(user_store, "users", "用户状态", "当前用户、RBAC 角色")
        Container(rbac_store, "rbac", "权限控制", "权限和作用域检查")
        Container(executions_store, "executions", "执行历史", "历史运行和活跃执行")
        Container(projects_store, "projects", "项目状态", "项目树和文件夹结构")
        Container(versions_store, "versions", "版本状态", "推送引用、版本信息")
        Container(templates_store, "templates", "模板状态", "模板列表和详情")
        Container(variables_store, "variables", "变量状态", "全局变量")
    }

    Container_Boundary(infra, "基础设施") {
        Container(router, "Vue Router", "路由系统", "路由守卫、懒加载")
        Container(api_client, "API 客户端", "REST 客户端", "Axios 封装的 API 调用")
        Container(push_client, "推送连接", "WebSocket/SSE", "实时更新连接")
        Container(i18n, "vue-i18n", "国际化", "多语言翻译支持")
        Container(telemetry, "遥测", "PostHog", "用户行为分析")
        Container(asset_loader, "资源加载器", "Assets", "静态资源、图标、字体")
    }
}

System_Boundary(external, "外部系统") {
    Container_Boundary(libs, "依赖库") {
        Container(design_system, "设计系统", "@n8n/design-system", "Vue 组件库")
        Container(i18n_pkg, "国际化包", "@n8n/i18n", "翻译文件")
        Container(rest_client_pkg, "REST 客户端", "@n8n/rest-api-client", "类型化 API 客户端")
        Container(workflow_pkg, "工作流包", "n8n-workflow", "工作流类型定义")
    }

    Container_Boundary(backends, "后端服务") {
        Container(cli_backend, "CLI 后端", "packages/cli", "REST API、/push 端点")
        Container(database, "数据库", "PostgreSQL/SQLite", "持久化存储")
    }
}

Rel(user, spa, "使用", "HTTPS")
Rel(spa, views, "渲染")
Rel(spa, stores, "状态管理")
Rel(spa, router, "导航")
Rel(spa, api_client, "API 调用")
Rel(spa, push_client, "实时更新")
Rel(spa, i18n, "翻译")
Rel(spa, telemetry, "埋点")

Rel(api_client, cli_backend, "REST 调用", "HTTPS")
Rel(push_client, cli_backend, "WebSocket/SSE", "/push")
Rel(design_system, spa, "组件")

Rel(workflows_store, api_client, "获取数据")
Rel(node_types_store, api_client, "加载节点")
Rel(credentials_store, api_client, "管理凭证")
Rel(executions_store, api_client, "获取执行")
Rel(push_client, ui_store, "更新 UI")
Rel(push_client, executions_store, "新执行")

Rel(node_view, workflows_store, "读取")
Rel(workflows_view, workflows_store, "列表")
Rel(settings_view, settings_store, "配置")
Rel(auth_view, user_store, "认证")

SHOW_LEGEND()
@enduml
