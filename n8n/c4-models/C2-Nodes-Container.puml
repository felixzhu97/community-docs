    Container(exec_engine, "执行引擎", "packages/core", "节点执行运行时")
}

Container_Boundary(node_categories, "节点分类") {
    Container(communication, "通讯类", "Slack, Discord, 邮件, Telegram, SMS")
    Container(cloud, "云平台类", "AWS, Google Cloud, Azure, DigitalOcean")
