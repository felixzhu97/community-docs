@startuml C2-Nodes-Container
!include lib/C4_Container.puml

LAYOUT_WITH_LEGEND()

title n8n 节点生态 - 容器图

System_Boundary(nodes_ecosystem, "n8n 节点生态系统") {
    Container(nodes_base, "基础节点", "packages/nodes-base", "307 个内置节点")
