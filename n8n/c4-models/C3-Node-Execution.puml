@startuml C3-Node-Execution
!include lib/C4_Container.puml
!include lib/C4_Component.puml

LAYOUT_WITH_LEGEND()

title n8n 节点执行 - 组件图

Container_Boundary(execution, "节点执行系统") {
    System_Boundary(lifecycle, "节点生命周期") {
        Component(initialize, "Initialize", "节点初始化", "加载凭证、准备上下文")
        Component(execute, "Execute", "节点执行", "运行节点逻辑")
        Component(finalize, "Finalize", "节点清理", "关闭连接、保存状态")
        Component(hook_before, "HooksNode.before", "前置钩子", "ExecuteBeforeHooks")
        Component(hook_after, "HooksNode.after", "后置钩子", "ExecuteAfterHooks")
        Component(close, "Close", "关闭函数", "节点关闭时清理资源")
    }

    System_Boundary(node_types, "节点类型") {
        Component(trigger_node, "触发节点", "TriggerNode", "Webhook/轮询触发")
        Component(regular_node, "普通节点", "RegularNode", "标准节点，execute() 方法")
        Component(webhook_node, "Webhook 节点", "WebhookNode", "HTTP 触发，webhookMethods")
        Component(polling_node, "轮询节点", "PollingNode", "定时检查，pollFunctions")
        Component(resource_node, "资源节点", "ResourceNode", "CRUD 操作节点")
        Component(operation_node, "操作节点", "OperationNode", "具体操作节点")
    }

    System_Boundary(data_flow, "数据流") {
        Component(input_data, "输入数据", "ITaskDataConnections", "节点输入数据")
        Component(output_data, "输出数据", "ITaskData", "节点输出数据")
        Component(binary_data, "二进制数据", "IBinaryKeyData", "二进制数据管理")
        Component(credentials, "凭证", "ICredentials", "加密凭证访问")
        Component(expressions, "表达式", "ExpressionParser", "解析 {{ $json.x }}")
        Component(json_data, "JSON 数据", "IDataObject", "JSON 对象操作")
        Component(binary_manager, "二进制管理", "BinaryDataManager", "二进制读写")
    }

    System_Boundary(exec_control, "执行控制") {
        Component(run_data, "runExecution", "WorkflowExecute", "编排整个执行")
        Component(routing, "RoutingNode", "路由输出", "路由数据到下一个节点")
        Component(wait_tracker, "WaitTracker", "暂停执行", "处理等待节点")
        Component(partial_exec, "PartialExecution", "恢复状态", "保存/恢复执行")
        Component(error_handling, "ErrorHandling", "错误处理", "continueOnFail, errorOutput")
        Component(retry, "RetryLogic", "重试机制", "自动重试配置")
        Component(timeout, "TimeoutHandler", "超时控制", "节点执行超时")
    }

    System_Boundary(context, "执行上下文") {
        Component(node_context, "NodeContext", "节点上下文", "IExecuteFunctions, ICredentialDataDecryptionMode")
        Component(workflow_context, "WorkflowContext", "工作流上下文", "工作流级别上下文")
        Component(request_context, "RequestContext", "请求上下文", "HTTP 请求上下文")
        Component(extension_context, "ExtensionContext", "扩展上下文", "自定义扩展")
    }
}

Container_Boundary(core, "Core 引擎 (packages/core)") {
    Component(exec_engine, "WorkflowExecute", "主执行器", "执行完整工作流")
    Component(node_exec, "executeNode", "节点运行器", "运行单个节点")
    Component(hook_system, "HooksNode", "钩子系统", "生命周期钩子")
    Component(expr_parser, "ExpressionParser", "表达式解析器", "解析和求值表达式")
    Component(node_helpers, "nodeExecuteFunctions", "辅助函数", "节点的辅助函数")
    Component(runner, "WorkflowRunner", "异步运行器", "后台执行启动")
    Component(wait_runner, "WaitRunner", "等待运行器", "处理等待状态")
    Component(partial_runner, "PartialExecutionRunner", "部分执行", "执行状态保存/恢复")
}

Container_Boundary(workflow_pkg, "Workflow 包 (packages/workflow)") {
    Component(workflow, "Workflow", "工作流类", "connections, nodes, settings")
    Component(i_node, "INode", "节点接口", "type, name, parameters, credentials")
    Component(i_conn, "IConnection", "连接接口", "源/目标节点链接")
    Component(i_credentials, "ICredentials", "凭证数据", "凭证数据访问接口")
    Component(expression, "Expression", "表达式类", "复杂表达式求值")
    Component(i_data_obj, "IDataObject", "数据对象", "JSON 数据类型")
    Component(task_data, "ITaskData", "任务数据", "输入/输出数据接口")
    Component(hook_result, "IHookResult", "钩子结果", "钩子函数返回值")
    Component(node_warning, "NodeWarning", "节点警告", "警告信息")
    Component(node_error, "NodeError", "节点错误", "错误信息")
}

Container_Boundary(loaded_nodes, "加载的节点") {
    Component(builtin_nodes, "内置节点", "Built-in nodes", "nodes-base 提供的节点")
    Component(community_nodes, "社区节点", "Community nodes", "用户安装的节点")
    Component(langchain_nodes, "LangChain 节点", "AI nodes", "AI 相关的节点")
}

Rel(run_data, routing, "路由")
Rel(routing, trigger_node, "触发工作流")
Rel(routing, regular_node, "执行普通节点")
Rel(routing, webhook_node, "Webhook 节点")

Rel(run_data, hook_before, "前置钩子")
Rel(hook_before, execute, "执行节点")
Rel(execute, hook_after, "后置钩子")
Rel(hook_after, finalize, "清理")

Rel(execute, input_data, "读取输入")
Rel(execute, output_data, "写入输出")
Rel(execute, credentials, "访问凭证")
Rel(execute, expressions, "解析表达式")
Rel(expressions, expr_parser, "使用解析器")

Rel(run_data, wait_tracker, "可能等待")
Rel(run_data, error_handling, "错误流程")
Rel(run_data, partial_exec, "部分保存")
Rel(run_data, retry, "重试")
Rel(run_data, timeout, "超时")

Rel(exec_engine, run_data, "管理执行")
Rel(exec_engine, node_exec, "执行节点")
Rel(exec_engine, hook_system, "生命周期")
Rel(exec_engine, runner, "异步任务")
Rel(exec_engine, wait_runner, "等待处理")

Rel(node_exec, node_context, "提供上下文")
Rel(node_context, workflow_context, "工作流上下文")
Rel(node_context, request_context, "请求上下文")

Rel(workflow, i_node, "包含节点")
Rel(workflow, i_conn, "包含连接")
Rel(node_exec, workflow_pkg, "使用接口")

Rel(exec_engine, builtin_nodes, "加载内置节点")
Rel(exec_engine, community_nodes, "加载社区节点")
Rel(exec_engine, langchain_nodes, "加载 AI 节点")

SHOW_LEGEND()
@enduml
